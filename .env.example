# Copy to .env and fill in. Never commit .env or any key.
# Find these in the Supabase dashboard under Project Settings, API.
# Locally, `npx supabase status` prints them.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo seeding (npm run seed:demo) reads a separate, gitignored .env.seed.local.
# Leave it out to seed the local Supabase. For the hosted project it holds:
#   SUPABASE_URL=https://your-project-ref.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=...      never in .env, never in the app
#   DEMO_EMAIL_SENIOR=...              optional, defaults to demo-senior@kneedit.test
#   (also DEMO_EMAIL_CAREGIVER, DEMO_EMAIL_PHYSIO, DEMO_EMAIL_FRIEND_AH_KOW, DEMO_EMAIL_FRIEND_SITI)
