{
  "name": "kneedit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "expo lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test",
    "i18n:review-list": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-review-list.mts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "seed:demo": "node --env-file-if-exists=.env.seed.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-demo.mts",
    "functions:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-functions.mts",
    "functions:deploy": "supabase functions deploy",
    "media:upload": "node --env-file-if-exists=.env.seed.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/upload-media.mts"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.29",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.5.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.1.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.46",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "~2.121.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/tests/helpers/"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
