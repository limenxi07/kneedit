{
  "name": "kneedit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "lint": "expo lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test",
    "i18n:review-list": "node scripts/i18n-review-list.mts"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "i18next": "^26.5.4",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/tests/helpers/"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}
